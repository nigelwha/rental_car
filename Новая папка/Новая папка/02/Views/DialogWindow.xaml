<Window x:Name="DialogWindowRoot"
        x:Class="_02.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:_02.Services"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Width="400"
        SizeToContent="Height">

    <Window.Resources>
        <SolidColorBrush x:Key="InfoPanelBrush" Color="#3498DB"/>
        <SolidColorBrush x:Key="ErrorPanelBrush" Color="#E74C3C"/>
        <SolidColorBrush x:Key="QuestionPanelBrush" Color="#F39C12"/>

        <SolidColorBrush x:Key="InfoHoverBrush" Color="#2980B9"/>
        <SolidColorBrush x:Key="ErrorHoverBrush" Color="#C0392B"/>
        <SolidColorBrush x:Key="QuestionHoverBrush" Color="#D68910"/>

        <Style x:Key="BaseDialogButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,8">
                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OkButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseDialogButtonStyle}">
            <Setter Property="Background" Value="{StaticResource InfoHoverBrush}"/>
        </Style>
        <Style x:Key="OkErrorButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseDialogButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ErrorHoverBrush}"/>
        </Style>
        <Style x:Key="YesButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseDialogButtonStyle}">
            <Setter Property="Background" Value="{StaticResource QuestionHoverBrush}"/>
        </Style>
        <Style x:Key="NoButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseDialogButtonStyle}">
            <Setter Property="Background" Value="#7F8C8D"/>
        </Style>
    </Window.Resources>

    <Border Margin="10" CornerRadius="12" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="1" Opacity="0.3"/>
        </Border.Effect>
        <StackPanel>
            <!-- Icon -->
            <Image Width="56" Height="56" Margin="0,24,0,8" HorizontalAlignment="Center">
                <Image.Style>
                    <Style TargetType="Image">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TypeDialog, ElementName=DialogWindowRoot}" Value="{x:Static services:DialogType.InfoType}">
                                <Setter Property="Source" Value="/Resources/Images/logo.png"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TypeDialog, ElementName=DialogWindowRoot}" Value="{x:Static services:DialogType.ErrorType}">
                                <Setter Property="Source" Value="/Resources/Images/logo.png"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TypeDialog, ElementName=DialogWindowRoot}" Value="{x:Static services:DialogType.QuestionType}">
                                <Setter Property="Source" Value="/Resources/Images/logo.png"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>

            <!-- Title -->
            <TextBlock x:Name="TitleBlock"
                       FontWeight="Bold" FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="20,0,20,8"
                       MaxHeight="60"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="#2C3E50"/>

            <!-- Message -->
            <TextBlock x:Name="MessageBlock"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="20,0,20,16"
                       MaxHeight="120"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="#7F8C8D"/>

            <!-- Buttons panel -->
            <Border Height="56" CornerRadius="0,0,12,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TypeDialog, ElementName=DialogWindowRoot}" Value="{x:Static services:DialogType.InfoType}">
                                <Setter Property="Background" Value="{StaticResource InfoPanelBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TypeDialog, ElementName=DialogWindowRoot}" Value="{x:Static services:DialogType.ErrorType}">
                                <Setter Property="Background" Value="{StaticResource ErrorPanelBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TypeDialog, ElementName=DialogWindowRoot}" Value="{x:Static services:DialogType.QuestionType}">
                                <Setter Property="Background" Value="{StaticResource QuestionPanelBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ContentControl x:Name="ButtonsContent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
