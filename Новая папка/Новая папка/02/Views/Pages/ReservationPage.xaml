<UserControl x:Class="_02.Views.Pages.ReservationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Grid Background="White" Margin="20">
		<StackPanel>
			<TextBlock Text="Бронирование автомобиля" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
			<TextBlock Text="Автомобиль:"/>
			<ComboBox ItemsSource="{Binding AvailableCars}" SelectedItem="{Binding SelectedCar}"
                      DisplayMemberPath="LicensePlate" Width="200"/>
			<TextBlock Text="Дата начала:" Margin="0,10,0,0"/>
			<DatePicker SelectedDate="{Binding StartDate}"/>
			<TextBlock Text="Дата окончания:" Margin="0,10,0,0"/>
			<DatePicker SelectedDate="{Binding EndDate}"/>
			<TextBlock Text="{Binding EstimatedCost, StringFormat='Стоимость: {0:N2} руб.'}"
                       FontSize="14" FontWeight="Bold" Margin="0,15,0,0"/>
			<Button Content="Забронировать" Style="{StaticResource ButtonStyle}"
                    Click="ReserveButton_Click" Width="150" Margin="0,15,0,0"/>
		</StackPanel>
	</Grid>
</UserControl>