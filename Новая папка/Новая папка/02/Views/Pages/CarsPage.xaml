<UserControl x:Class="_02.Views.Pages.CarsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <!-- Стиль карточки автомобиля -->
        <Style x:Key="CarCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель фильтров -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Поиск:" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="260" Height="32"
                             Text="{Binding SearchString, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource HeaderSearchBoxStyle}"/>
                </StackPanel>

                <!-- Сортировка -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Сортировка:" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="200" Height="32"
                              ItemsSource="{Binding SortOptions}"
                              SelectedIndex="{Binding SelectedSort}"/>
                </StackPanel>

                <!-- Фильтры -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <!-- Статусы -->
                    <GroupBox Header="Статус" FontSize="12" Margin="0,0,10,0">
                        <ItemsControl ItemsSource="{Binding StatusFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Status.Name}" IsChecked="{Binding IsChecked}"
                                              Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <!-- Класс -->
                    <GroupBox Header="Класс" FontSize="12" Margin="0,0,10,0">
                        <ComboBox ItemsSource="{Binding ClassFilters}"
                                  SelectedItem="{Binding SelectedClass}"
                                  Width="120"/>
                    </GroupBox>

                    <!-- Цена -->
                    <GroupBox Header="Цена в сутки" FontSize="12" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding PriceFrom, StringFormat={}{0:N0}}" Width="80" Height="24"/>
                            <TextBlock Text="—" VerticalAlignment="Center" Margin="4,0"/>
                            <TextBox Text="{Binding PriceTo, StringFormat={}{0:N0}}" Width="80" Height="24"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Кнопка сброса -->
                    <Button Content="Сбросить фильтры" Style="{StaticResource ButtonStyle}"
                            Visibility="Collapsed"
                            Click="ResetFilters_Click" Margin="10,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Контент: карточки и таблица -->
        <TabControl Grid.Row="1" Margin="10" BorderThickness="0" Background="Transparent">
            <TabItem Header="Карточки">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox ItemsSource="{Binding Cars}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CarCardStyle}" Width="220">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LicensePlate}" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                                        <TextBlock Foreground="#7F8C8D" FontSize="12">
                                            <Run Text="Марка: "/><Run Text="{Binding Model.Brand.Name}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="#7F8C8D" FontSize="12">
                                            <Run Text="Модель: "/><Run Text="{Binding Model.Name}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="#7F8C8D" FontSize="12">
                                            <Run Text="Год: "/><Run Text="{Binding ManufactureYear}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="#7F8C8D" FontSize="12">
                                            <Run Text="Цена/сут: "/><Run Text="{Binding BaseRentalRatePerDay, StringFormat={}{0:N2}}"/>
                                        </TextBlock>
                                        <Border Background="#FDEBD0" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Status.Name}" FontSize="11" Foreground="#F39C12" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Таблица">
                <DataGrid ItemsSource="{Binding Cars}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                          SelectionMode="Single" GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                          Margin="0,8,0,0">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="#1E3A5F"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Госномер" Binding="{Binding LicensePlate}" Width="120"/>
                        <DataGridTextColumn Header="Марка" Binding="{Binding Model.Brand.Name}" Width="100"/>
                        <DataGridTextColumn Header="Модель" Binding="{Binding Model.Name}" Width="120"/>
                        <DataGridTextColumn Header="Год выпуска" Binding="{Binding ManufactureYear}" Width="90"/>
                        <DataGridTextColumn Header="Цена/сут" Binding="{Binding BaseRentalRatePerDay, StringFormat={}{0:N2}}" Width="100"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status.Name}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>