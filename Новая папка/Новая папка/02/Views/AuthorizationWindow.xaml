<Window x:Class="_02.Views.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:_02.ViewModels"
        Title="Авторизация"
        Height="450" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="White"
        Style="{StaticResource WindowStyle}">

    <Window.DataContext>
        <viewModels:AuthorizationViewModel/>
    </Window.DataContext>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Image Grid.Row="0" Source="/Resources/Images/logo.png"
               Width="70" Height="70" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="Прокат автомобилей"
                   FontSize="16" FontWeight="Bold" Foreground="#2C3E50"
                   HorizontalAlignment="Center" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="2" Text="Вход в систему"
                   FontSize="15" Foreground="Black"
                   HorizontalAlignment="Center" Margin="0,0,0,25"/>

        <TextBlock Grid.Row="3" Text="Логин:" FontSize="15" Foreground="Black" Margin="0,0,0,5"/>
        <TextBox Grid.Row="3" x:Name="LoginTextBox"
                 Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                 Height="35" Margin="0,25,0,15"
                 VerticalContentAlignment="Center" FontSize="13"
                 BorderBrush="#E0E0E0" BorderThickness="1"/>

        <TextBlock Grid.Row="4" Text="Пароль:" FontSize="15" Foreground="Black" Margin="0,0,0,5"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="4"
                     Height="35" Margin="0,25,0,15"
                     VerticalContentAlignment="Center" FontSize="13"
                     BorderBrush="#E0E0E0" BorderThickness="1"/>

        <Button Grid.Row="5" Content="ВОЙТИ"
                Height="40" FontSize="14" FontWeight="Bold"
                Foreground="White" Background="#F39C12" BorderThickness="0"
                Cursor="Hand" Click="LoginButton_Click" Margin="0,10,0,0"/>

        <TextBlock Grid.Row="6" x:Name="ErrorText"
                   Foreground="#E74C3C" FontSize="12"
                   HorizontalAlignment="Center" Margin="0,15,0,0"/>
    </Grid>
</Window>
