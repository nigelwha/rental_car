<Window x:Class="_02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:_02.ViewModels"
        xmlns:pages="clr-namespace:_02.Views.Pages"
        Title="Прокат автомобилей"
        Height="650" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowStyle}">

    <Window.DataContext>
        <viewModels:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:CarsViewModel}">
            <pages:CarsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ReservationViewModel}">
            <pages:ReservationPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:RentalsViewModel}">
            <pages:RentalsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:FinesViewModel}">
            <pages:FinesPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ClientsViewModel}">
            <pages:ClientsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:RegisterEmployeeViewModel}">
            <pages:RegisterEmployeePage/>
        </DataTemplate>

        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavBorder" Background="Transparent" Padding="20,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхнее меню -->
        <DockPanel Grid.Row="0" Background="#1E3A5F">
            <!-- Логотип и название -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,8">
                <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,8,0" Background="#F39C12"/>
                <TextBlock Text="Прокат автомобилей" FontSize="16" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Навигация -->
            <ListBox DockPanel.Dock="Left"
                     ItemsSource="{Binding ViewModelsCollection}"
                     SelectedItem="{Binding SelectedViewModel}"
                     ItemContainerStyle="{StaticResource NavItemStyle}"
                     Background="Transparent" BorderThickness="0"
                     VerticalAlignment="Center">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" FontSize="13"
                                   Foreground="White" Padding="0"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Панель пользователя (справа) -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="0,8,16,8">
                <!-- Аватар -->
                <Border Width="32" Height="32" CornerRadius="16" Margin="0,0,8,0" Background="#F39C12"/>
                <!-- ФИО и роль -->
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding UserFullName}" FontSize="11"
                               FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="{Binding UserRole}" FontSize="10" Foreground="#CCFFFFFF"/>
                </StackPanel>
                <!-- Кнопка выхода -->
                <Button Width="28" Height="28" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" ToolTip="Выйти"
                        Click="LogoutButton_Click">
                    <TextBlock Text="⏻" FontSize="16" Foreground="White"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Контент страниц -->
        <ContentControl Grid.Row="1" Content="{Binding SelectedViewModel}" Margin="0"/>
    </Grid>
</Window>